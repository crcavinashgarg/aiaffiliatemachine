  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/inject-config.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/AF-Thank-You",
      "destination": "/AF-Thank-You.html"
